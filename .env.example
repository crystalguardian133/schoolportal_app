APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Deployment guards (used by entrypoint.sh in Docker/Render):
# RUN_MIGRATIONS: auto (default) | always | never
#   auto  - migrate only when the DB is empty or already tracked by Laravel migrations
#           (pending changes are applied; an untracked DB with data is left untouched)
#   always- force migrations even against an untracked DB that already has data
#   never - never run migrations
# RUN_SEED: true to seed the DB, but only when it is empty (existing data is never re-seeded)
# APP_DEPLOY_STRICT: true to abort container startup if untracked data is detected
#   (protects against accidental damage; default false starts the app without touching data)
RUN_MIGRATIONS=auto
RUN_SEED=false
APP_DEPLOY_STRICT=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie hardening. SESSION_SECURE_COOKIE forces HTTPS-only cookies; leave unset
# to auto-enable it everywhere except local (plain-HTTP dev). Set explicitly on
# ngrok/Render if APP_ENV stays "local" there (e.g. SESSION_SECURE_COOKIE=true).
# SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Reverb WebSockets (requires BROADCAST_CONNECTION=reverb + a running reverb server via `php artisan reverb:start`)
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST="localhost"
# REVERB_PORT=8081
# REVERB_SCHEME=http
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Web Push Notifications (minishlink/web-push)
# Set PUSH_ENABLED=true to send push notifications for published announcements.
# Generate VAPID keys with: php artisan tinker --execute="echo json_encode(Minishlink\WebPush\VAPID::createVapidKeys());"
PUSH_ENABLED=true
VAPID_SUBJECT=mailto:admin@dnhs.edu.ph
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

