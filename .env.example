APP_NAME=Laravel
APP_ENV=local
APP_KEY="base64key"
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Deployment guards (used by entrypoint.sh in Docker/Render):
# RUN_MIGRATIONS: auto (default) | always | never
#   auto  - migrate only when the DB is empty or already tracked by Laravel migrations
#           (pending changes are applied; an untracked DB with data is left untouched)
#   always- force migrations even against an untracked DB that already has data
#   never - never run migrations
# RUN_SEED: true to seed the DB, but only when it is empty (existing data is never re-seeded)
# APP_DEPLOY_STRICT: true to abort container startup if untracked data is detected
#   (protects against accidental damage; default false starts the app without touching data)
RUN_MIGRATIONS=auto
RUN_SEED=false
APP_DEPLOY_STRICT=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
#Database config both for local and online database, use credentials from your db provider. Here's an example using sqlite.
DB_CONNECTION=sqlite # use mysql if you want to use mysql, or pgsql for postgresql, etc.
# DB_HOST=127.0.0.1 << database host if using mysql via xampp or other local server, uncomment and set the host
# DB_PORT=3306 << database port if using mysql via xampp or other local server, uncomment and set the port
# DB_DATABASE=db.name << use your database name here
# DB_USERNAME=root # default username for mysql, change if using other db or if you have a different username
# DB_PASSWORD= # default password for mysql, change if using other db or if you have a different password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie hardening. SESSION_SECURE_COOKIE forces HTTPS-only cookies; leave unset
# to auto-enable it everywhere except local (plain-HTTP dev). Set explicitly on
# ngrok/Render if APP_ENV stays "local" there (e.g. SESSION_SECURE_COOKIE=true).
# SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Reverb WebSockets (requires BROADCAST_CONNECTION=reverb + a running reverb server via `php artisan reverb:start`)
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST="localhost"
# REVERB_PORT=8081
# REVERB_SCHEME=http
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#Setting Laravel mailer to log for local development. Change to smtp and set credentials for production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (S3-compatible object storage; use_path_style_endpoint must be true)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=your-bucket
R2_REGION=auto
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_URL=https://pub-<your-public-bucket-id>.r2.dev
R2_USE_PATH_STYLE_ENDPOINT=true

# Web Push Notifications (minishlink/web-push)
# Set PUSH_ENABLED=true to send push notifications for published announcements.
# Generate VAPID keys with: php artisan tinker --execute="echo json_encode(Minishlink\WebPush\VAPID::createVapidKeys());"
PUSH_ENABLED=true
VAPID_SUBJECT=mailto:admin@dnhs.edu.ph
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

