# Production environment template. Copy to `.env.prod` and fill in real values:
#   cp .env.prod.example .env.prod
# NEVER commit `.env.prod` (gitignored). NEVER reuse dev secrets here.
#
# Database: copy YOUR existing values verbatim (same key names, TCP only --
# containers have no DB_SOCKET). This file renames nothing.
DB_CONNECTION=mysql
DB_HOST=your-prod-db-host
DB_PORT=3306
DB_DATABASE=your-prod-db-name
DB_USERNAME=your-prod-db-user
DB_PASSWORD=your-prod-db-password

APP_NAME="DNHS Portal"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN_HERE
APP_KEY=base64:PASTE_OUTPUT_OF_php_artisan_key:generate_--show

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=PASTE_openssl_rand_-hex_4
REVERB_APP_KEY=PASTE_openssl_rand_-hex_10
REVERB_APP_SECRET=PASTE_openssl_rand_-hex_16
# Server-side bind (overridden to 0.0.0.0:8081 by compose environment).
REVERB_HOST=0.0.0.0
REVERB_PORT=8081
REVERB_SCHEME=https

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=file

PUSH_ENABLED=true
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=PASTE_FRESH_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=PASTE_FRESH_VAPID_PRIVATE_KEY

# Copy remaining integrations verbatim from local .env as needed
# (mail, S3/R2, music/yt-dlp, etc.).
