# Compose-time variables (image BUILD args + APP_URL interpolation).
# Copy to `deploy.env` and fill in:  cp deploy.env.example deploy.env
# NEVER commit `deploy.env` (gitignored). Pass it explicitly every time:
#   docker compose --env-file deploy.env build
#   docker compose --env-file deploy.env up -d
# (The default `.env` is the LARAVEL env and must NOT be used for this.)
APP_DOMAIN=YOUR_DOMAIN_HERE
APP_KEY=base64:PASTE_OUTPUT_OF_php_artisan_key:generate_--show
REVERB_APP_KEY=PASTE_SAME_VALUE_AS_REVERB_APP_KEY_IN_.env.prod
VITE_APP_NAME=DNHS Portal
